<!doctype html>
<html lang="fr">

<head>
    <title>{{report.title}}</title>
    <style>
        @page {
            margin: 0;
            padding-top: 3.5cm;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        div.break {
            break-before: always;
        }

        ul {
            list-style-type: none;
        }

        img.property-image {
            max-height: 22cm;
        }

        .output-img {
            text-align: center;
        }

        .no-margin {
            margin: 0;
        }

        .small-margin-bottom {
            margin-bottom: 0.5rem;
        }

        header>* {
            position: fixed;
            padding: 0.5cm;
            top: -3.5cm;
            height: 2.5cm;
        }

        header .logo {
            left: 0;
            width: 130px;
        }

        header .title {
            margin: auto;
            left: 150px;
            width: 380px;
        }

        .index header .title {
            width: 600px;
        }

        header .metazone-img {
            right: 0;
            width: 180px;
        }

        .body {
            padding: 1cm;
            box-decoration-break: clone
        }

        header img {
            height: 100%;
        }

        h2,
        h3,
        h5 {
            color: #002554;
            position: relative;
        }

        .underline::after {
            content: "";
            background: #5bc2e7;
            position: absolute;
            bottom: -10px;
            left: 0;
        }

        h1.underline::after {
            height: 10px;
            width: 100px;
        }

        h2.underline::after {
            height: 8px;
            width: 80px;
        }

        h3.underline::after,
        li.underline::after {
            height: 5px;
            width: 50px;
        }
                .special-paragraph {
          font-size: 24px;
          font-weight: bold;
          color: #002554;
          position: relative;
        }

        .special-paragraph::after {
          content: ''; /* Required for pseudo-element content */
          display: block; /* Ensures the pseudo-element behaves as a block element */
          height: 8px;
          width: 80px;
          background-color: #5bc2e7; /* Just for demonstration */
          position: absolute; /* Position the pseudo-element */
          bottom: -10px; /* Adjust as needed to position the pseudo-element */
          left: 0; /* Adjust as needed to position the pseudo-element */
        }
    </style>
</head>

<body>

    <div class="index">
        <header>
            <div class="logo">
                <img src="logo_shom.png">
            </div>

            <div class="title">
                <h2 class="underline">
                    {{report.title}} - {{report.date}}
                </h2>
                <p style="color: #002554; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
                    Index
                </p>
            </div>
        </header>

        <div class="body">
                <p class="special-paragraph">
                    Liste des méta-zones
                </p>
            <ul>
                {% for metazone in report.metazones %}
                <li>
                    <p style="color: #002554; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
                        {{metazone.properties.name}}
                    </p>
                </li>
                {% endfor %}
            </ul>

            <p class="special-paragraph">
                Méta-zones
            </p>
            {% for metazone in report.metazones %}
            <h3>
                {{metazone.properties.name}}
            </h3>
            <ul>
                {% for functionality in metazone.functionalities %}
                <li>
                    <h5 class="no-margin">{{functionalities_desc[functionality.functionality]}}</h5>
                    <ul>
                        {% for output in functionality.outputs %}
                        <li>
                            {{sub_functionalities_desc[output.plot]}}
                        </li>
                        {% endfor %}
                    </ul>
                </li>
                {% endfor %}
            </ul>
            {% endfor %}

        </div>
    </div>

</body>

</html>